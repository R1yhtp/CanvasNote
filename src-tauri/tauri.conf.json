{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanvasNote",
  "version": "0.1.0",
  "identifier": "app.canvasnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CanvasNote",
        "width": 1280,
        "height": 850,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
